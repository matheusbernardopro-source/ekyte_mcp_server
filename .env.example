# Ekyte MCP Server - configuracao
# 2 variaveis obrigatorias + 2 opcionais.
# Auth usa JWT Bearer, o mesmo que o front app.ekyte.com envia.

# JWT Bearer do Ekyte - copie do DevTools > Network > header Authorization
EKYTE_BEARER_TOKEN=

# ID numerico da empresa, visivel na URL /api/companies/XXXX/...
EKYTE_COMPANY_ID=

# Transporte: 'http' para servidor remoto, 'stdio' para Codex local
TRANSPORT=stdio

# Porta do servidor HTTP (default: 3000)
PORT=3000
