{
  "name": "ekyte-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server do Ekyte para Codex: tarefas, projetos, fases, usuarios, workspaces e apontamentos de horas.",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheusbernardopro-source/ekyte_mcp_server.git"
  },
  "bugs": {
    "url": "https://github.com/matheusbernardopro-source/ekyte_mcp_server/issues"
  },
  "homepage": "https://github.com/matheusbernardopro-source/ekyte_mcp_server#readme",
  "keywords": [
    "mcp",
    "codex",
    "ekyte",
    "projects",
    "tasks",
    "time-tracking"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
